{
  "name": "idiom-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && rm -rf dist .parcel-cache && pnpm build:web",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:web": "parcel build index.html --dist-dir dist --no-source-maps",
    "db:migrate:local": "wrangler d1 migrations apply idiom-quest-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply idiom-quest-db --remote",
    "dev:cf": "pnpm build && wrangler pages dev",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name idiom-quest"
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@parcel/config-default": "^2.16.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "html-inline": "^1.2.0",
    "oxlint": "^1.90.0",
    "parcel": "^2.16.4",
    "parcel-resolver-tspaths": "^0.0.9",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
